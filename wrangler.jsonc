{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "841e0fdf-629e-4faf-83e6-45e6e0dec063","database_name": "web-app1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1db4be87cea24dd19e0ec84de1c748c6" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
